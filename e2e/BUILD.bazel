"""e2e —— Playwright 端到端测试。

Playwright 浏览器二进制约 200MB/家，不适合进 Bazel sandbox。
策略：
  - 源码 / 配置 / fixtures / pages / helpers 通过 copy_to_bin 管起来
  - 浏览器由 `pnpm exec playwright install chromium` 一次性装到
    本地 ~/Library/Caches/ms-playwright（macOS）或 ~/.cache/ms-playwright（Linux）
  - `bazel run //e2e:test` 通过 PLAYWRIGHT_BROWSERS_PATH 指过去

**单 importer 约束**：本目录 **不是 pnpm importer**（无 package.json）。
所有依赖（@playwright/test, @axe-core/playwright, undici, @types/node, typescript）
全部声明在 root package.json，从 root node_modules 解析。
原因：aspect_rules_js 会为每个 pnpm importer 建独立 node_modules，
ESM 在子 importer 内 import 同一 npm 包会得到不同 link path，
Playwright runner 启动时 module identity 检查失败（"two different versions"）。
"""

load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:@playwright/test/package_json.bzl", playwright_bin = "bin")

# 源码（tests / fixtures / pages / helpers / scripts / config）
js_library(
    name = "sources",
    srcs = glob(
        [
            "tests/**/*.ts",
            "fixtures/**/*.ts",
            "pages/**/*.ts",
            "helpers/**/*.ts",
            "scripts/**/*.ts",
            "scripts/**/*.mjs",
            "playwright.config.ts",
            "tsconfig.json",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

exports_files([
    "playwright.config.ts",
    "tsconfig.json",
])

# Playwright test CLI，走 root npm 包的 bin 导出（不在 e2e 单独 link）。
# 浏览器由本地缓存提供：首次需 `pnpm exec playwright install chromium`。
playwright_bin.playwright_binary(
    name = "test_bin",
    chdir = package_name(),
    data = [
        ":sources",
        # root 的所有 npm link：e2e 通过 ESM 父链解析到 <runfiles>/_main/node_modules/。
        "//:node_modules/@playwright/test",
        "//:node_modules/@axe-core/playwright",
        "//:node_modules/@types/node",
        "//:node_modules/undici",
    ],
    fixed_args = ["test"],
    visibility = ["//visibility:public"],
)

alias(
    name = "test",
    actual = ":test_bin",
    visibility = ["//visibility:public"],
)

# 一键清理 e2e 留下的进程（前端 next dev）+ 调 deploy/dev:clean 清掉 backend/docker。
# 用法：bazel run //e2e:clean
sh_binary(
    name = "clean",
    srcs = ["scripts/clean_runner.sh"],
    visibility = ["//visibility:public"],
)
