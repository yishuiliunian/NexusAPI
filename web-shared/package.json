{
  "name": "@nexusapi/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./ui": "./src/ui/index.ts",
    "./i18n": "./src/i18n/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "echo 'shared has no build step'",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:gen": "openapi-typescript ../backend/api/openapi.yaml -o src/api/schema.ts"
  },
  "dependencies": {
    "@types/react": "19.0.2",
    "clsx": "^2.1.1",
    "recharts": "^3.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "5.7.3",
    "vitest": "^2.1.8"
  }
}
