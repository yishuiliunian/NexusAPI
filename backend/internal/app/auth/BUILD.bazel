load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "auth",
    srcs = ["auth.go"],
    importpath = "github.com/yishuiliunian/nexusapi/backend/internal/app/auth",
    visibility = ["//backend:__subpackages__"],
    deps = [
        "//backend/internal/domain/user",
        "//backend/pkg/errors",
        "@org_golang_x_crypto//bcrypt",
    ],
)

go_test(
    name = "auth_test",
    srcs = ["auth_test.go"],
    embed = [":auth"],
    deps = [
        "//backend/internal/domain/user",
        "//backend/pkg/errors",
    ],
)
