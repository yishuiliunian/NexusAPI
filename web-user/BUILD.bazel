"""web-user —— Next.js 用户端。

Bazel target:
  :next        build（next build）
  :next_dev    dev（next dev）
  :next_start  prod（next start）
  :image       OCI 镜像
"""

load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//web-user:next/package_json.bzl", next_bin = "bin")
load("//build:next.bzl", "next")
load("//build:next_oci.bzl", "next_oci_image")

# 根 npm 子集 link 到本包 node_modules
npm_link_all_packages(name = "node_modules")

# Next.js build 用的 binary target
next_bin.next_binary(
    name = "next_js_binary",
    visibility = ["//visibility:public"],
)

exports_files([
    "next.config.ts",
    "tsconfig.json",
    "postcss.config.mjs",
    "tailwind.config.ts",
])

# 应用源码（.tsx / .ts / .css）
# Next App Router 直接消费源文件，无需 ts_project 编译
copy_to_bin(
    name = "sources",
    srcs = glob(
        [
            "app/**/*.tsx",
            "app/**/*.ts",
            "app/**/*.css",
            "components/**/*.tsx",
            "components/**/*.ts",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# 静态资源（无 public/ 目录时留空）
filegroup(
    name = "public",
    srcs = glob(
        ["public/**/*"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# Next 三件套：build / dev / start
next(
    name = "next",
    srcs = [
        ":public",
        ":sources",
        "//web-shared:sources",
    ],
    data = [
        "next.config.ts",
        "next-env.d.ts",
        "postcss.config.mjs",
        "tailwind.config.ts",
        "tsconfig.json",
        ":node_modules",
        "//:package_json_bin",
    ],
    next_bin = "./node_modules/.bin/next",
    next_js_binary = ":next_js_binary",
    visibility = ["//visibility:public"],
)

# 别名方便：bazel run //web-user:dev
alias(
    name = "dev",
    actual = ":next_dev",
    visibility = ["//visibility:public"],
)

alias(
    name = "start",
    actual = ":next_start",
    visibility = ["//visibility:public"],
)

# OCI 镜像
next_oci_image(
    name = "image",
    labels = {"org.opencontainers.image.title": "nexusapi-web-user"},
    next_build = ":next",
    repository = "ghcr.io/yishuiliunian/nexusapi-web-user",
)
