// NexusAPI Design System · Tokens
//
// 基调：科技冷灰 + 品牌蓝 + 功能色，轻量扁平
// 字体：Inter / 系统默认
//
// 访问方式：tokens.colors.primary / tokens.spacing.md 等

token colors {
    // 品牌
    primary     = #2563EB
    primary-600 = #2563EB
    primary-500 = #3B82F6
    primary-400 = #60A5FA
    primary-100 = #DBEAFE
    primary-50  = #EFF6FF

    // 中性色（文字 / 边框 / 背景）
    gray-900 = #0F172A   // 主文字
    gray-800 = #1E293B
    gray-700 = #334155
    gray-600 = #475569   // 次要文字
    gray-500 = #64748B   // 弱化文字
    gray-400 = #94A3B8
    gray-300 = #CBD5E1   // 边框
    gray-200 = #E2E8F0   // 分隔
    gray-100 = #F1F5F9   // 底色 hover
    gray-50  = #F8FAFC   // 页面背景

    // 功能色
    success   = #10B981
    success-bg = #ECFDF5
    warning   = #F59E0B
    warning-bg = #FFFBEB
    danger    = #EF4444
    danger-bg  = #FEF2F2
    info      = #06B6D4
    info-bg   = #ECFEFF

    // 图表调色板（10 色）
    chart-1  = #2563EB
    chart-2  = #10B981
    chart-3  = #F59E0B
    chart-4  = #8B5CF6
    chart-5  = #EF4444
    chart-6  = #06B6D4
    chart-7  = #EC4899
    chart-8  = #84CC16
    chart-9  = #F97316
    chart-10 = #14B8A6

    // Admin 深色基调
    slate-900 = #0F172A
    slate-800 = #1E293B
    slate-700 = #334155
    slate-600 = #475569

    // 白
    white = #FFFFFF
}

token spacing {
    xs  = 4
    sm  = 8
    md  = 12
    lg  = 16
    xl  = 24
    xxl = 32
    xxxl = 48
}

token radius {
    xs  = 4
    sm  = 6
    md  = 8
    lg  = 12
    xl  = 16
    full = 999
}

token typography {
    // 标题
    h1   = { size = 32, weight = bold,     line-height = 40 }
    h2   = { size = 24, weight = semibold, line-height = 32 }
    h3   = { size = 20, weight = semibold, line-height = 28 }
    h4   = { size = 18, weight = semibold, line-height = 26 }

    // 正文
    body     = { size = 14, weight = normal,   line-height = 20 }
    body-lg  = { size = 16, weight = normal,   line-height = 24 }
    body-sm  = { size = 13, weight = normal,   line-height = 18 }

    // 辅助
    caption  = { size = 12, weight = normal,   line-height = 16 }
    tiny     = { size = 11, weight = medium,   line-height = 14 }

    // 数字（金额 / 统计）
    stat-lg  = { size = 32, weight = bold,     line-height = 36 }
    stat     = { size = 24, weight = bold,     line-height = 28 }
    stat-sm  = { size = 18, weight = semibold, line-height = 22 }
}

token shadow {
    // 扁平化，轻阴影
    sm = [0, 1, 2,  #0F172A14]
    md = [0, 4, 12, #0F172A1A]
    lg = [0, 10, 24, #0F172A26]
    // 内阴影（按钮 active）
    inset-sm = [0, 1, 2, #0F172A1A]
}

token border {
    thin   = [1, #E2E8F0]
    strong = [1, #CBD5E1]
    focus  = [2, #3B82F6]
}