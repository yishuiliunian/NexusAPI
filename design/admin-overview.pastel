// Admin Overview · 全局监控台
//
// 定位：运营 / 运维 / 财务多视角的全局看板
// 布局：
//   顶栏（管理员 / 时间窗口）
//   4 大 KPI 卡（今日请求 / 今日收入 / 活跃用户 / 渠道健康）
//   请求量趋势（面积）+ 收入趋势（线）双栏
//   渠道健康表（延迟 + 成功率 + 状态）
//   Top 用户表 + 按模型柱状

include "./components.pastel"

canvas "admin-overview" {
    width      = 1600
    height     = 1800
    background = colors.slate-900
}

frame shell {
    width = fill height = fill layout = horizontal

    // ---------- Admin Sidebar（深色）----------
    frame sidebar {
        width = 240 height = fill fill = colors.slate-800
        layout = vertical padding = [24, 16] gap = 8

        frame logo {
            width = fill layout = horizontal gap = 10 align = center padding = [0, 8, 16, 8]
            frame icon { width = 28 height = 28 fill = colors.primary-500 radius = radius.md layout = vertical justify = center align = center
                text "N" { size = 16, weight = bold, color = colors.white } }
            frame title-col {
                width = hug layout = vertical gap = 0
                text "NexusAPI"  { size = 16, weight = bold, color = colors.white }
                text "管理后台"  { size = 10, weight = medium, color = #94A3B8, text-transform = uppercase, letter-spacing = 1.0 }
            }
        }

        text "运营" { size = 11, weight = medium, color = #64748B, text-transform = uppercase }

        frame active {
            width = fill padding = [10, 12] layout = horizontal gap = 10 align = center
            fill = #2563EB33 radius = radius.md
            frame d { width = 4 height = 20 fill = colors.primary-500 radius = 2 }
            text "全局概览" { size = 14, weight = semibold, color = colors.white }
        }

        frame i1 { width = fill padding = [10, 16] text "渠道管理"   { size = 14, weight = normal, color = #CBD5E1 } }
        frame i2 { width = fill padding = [10, 16] text "模型价格"   { size = 14, weight = normal, color = #CBD5E1 } }
        frame i3 { width = fill padding = [10, 16] text "用户"      { size = 14, weight = normal, color = #CBD5E1 } }
        frame i4 { width = fill padding = [10, 16] text "分组"      { size = 14, weight = normal, color = #CBD5E1 } }

        text "财务" { size = 11, weight = medium, color = #64748B, text-transform = uppercase }

        frame i5 { width = fill padding = [10, 16] text "订单"      { size = 14, weight = normal, color = #CBD5E1 } }
        frame i7 {
            width = fill padding = [10, 16] layout = horizontal gap = 8 align = center
            text "激活码生成" { size = 14, weight = normal, color = #CBD5E1 }
            frame dot { width = 6 height = 6 fill = colors.warning radius = radius.full }
        }

        text "系统" { size = 11, weight = medium, color = #64748B, text-transform = uppercase }

        frame i8 { width = fill padding = [10, 16] text "审计日志" { size = 14, weight = normal, color = #CBD5E1 } }
        frame i9 { width = fill padding = [10, 16] text "系统设置" { size = 14, weight = normal, color = #CBD5E1 } }
    }

    // ---------- Main（深色） ----------
    frame main {
        width = fill height = fill padding = [32, 40] layout = vertical gap = 24

        // 顶栏
        frame topbar {
            width = fill height = hug layout = horizontal align = center justify = space-between

            frame title-group {
                width = hug layout = vertical gap = 4
                text "全局概览" { size = 28, weight = bold, color = colors.white }
                text "今日：2026-04-18 · 最近 7 天全局数据" { size = 13, weight = normal, color = #94A3B8 }
            }

            frame actions {
                width = hug layout = horizontal gap = 12 align = center

                // 状态灯
                frame health-indicator {
                    padding = [6, 12] layout = horizontal gap = 8 align = center
                    fill = #10B98126 radius = radius.full
                    shape dot { type = ellipse width = 8 height = 8 fill = colors.success }
                    text "系统正常" { size = 12, weight = semibold, color = #6EE7B7 }
                }

                // 时间 tab
                frame tabs {
                    width = hug layout = horizontal
                    fill = colors.slate-800 radius = radius.md stroke = [1, #334155]

                    frame tab1 { padding = [8, 14] text "1D"  { size = 13, weight = medium, color = #94A3B8 } }
                    frame tab2 { padding = [8, 14] fill = #2563EB4D text "7D" { size = 13, weight = semibold, color = colors.white } }
                    frame tab3 { padding = [8, 14] text "30D" { size = 13, weight = medium, color = #94A3B8 } }
                    frame tab4 { padding = [8, 14] text "90D" { size = 13, weight = medium, color = #94A3B8 } }
                }

                // 用户按钮
                frame admin-pill {
                    width = hug padding = [6, 10] fill = colors.slate-800 radius = radius.full
                    layout = horizontal align = center gap = 8 stroke = [1, #334155]
                    frame av { width = 24 height = 24 fill = colors.primary-500 radius = radius.full layout = vertical justify = center align = center
                        text "A" { size = 11, weight = bold, color = colors.white } }
                    text "admin@e2e.test" { size = 12, weight = medium, color = colors.white }
                }
            }
        }

        // KPI 卡 x4
        frame kpi-row {
            width = fill layout = horizontal gap = 16

            // 今日请求
            frame kpi1 {
                width = fill height = hug padding = 20
                fill = colors.slate-800 radius = radius.lg stroke = [1, #334155]
                layout = vertical gap = 10

                frame head {
                    width = fill layout = horizontal justify = space-between align = center
                    text "今日请求" { size = 12, weight = medium, color = #94A3B8 }
                    use badge-success("↑ 23%")
                }
                text "47,285" { size = 32, weight = bold, color = colors.white, line-height = 36 }
                text "较昨日 +8,812 次" { size = 11, weight = normal, color = #64748B }
            }

            // 今日收入
            frame kpi2 {
                width = fill height = hug padding = 20
                fill = colors.slate-800 radius = radius.lg stroke = [1, #334155]
                layout = vertical gap = 10

                frame head {
                    width = fill layout = horizontal justify = space-between align = center
                    text "今日收入" { size = 12, weight = medium, color = #94A3B8 }
                    use badge-success("↑ 15%")
                }
                text "¥1,284.32" { size = 32, weight = bold, color = colors.white, line-height = 36 }
                text "本月累计 ¥24,917" { size = 11, weight = normal, color = #64748B }
            }

            // 活跃用户
            frame kpi3 {
                width = fill height = hug padding = 20
                fill = colors.slate-800 radius = radius.lg stroke = [1, #334155]
                layout = vertical gap = 10

                frame head {
                    width = fill layout = horizontal justify = space-between align = center
                    text "活跃用户" { size = 12, weight = medium, color = #94A3B8 }
                    use badge-info("今日")
                }
                text "342" { size = 32, weight = bold, color = colors.white, line-height = 36 }
                text "总注册 1,247 人" { size = 11, weight = normal, color = #64748B }
            }

            // 成功率
            frame kpi4 {
                width = fill height = hug padding = 20
                fill = colors.slate-800 radius = radius.lg stroke = [1, #334155]
                layout = vertical gap = 10

                frame head {
                    width = fill layout = horizontal justify = space-between align = center
                    text "成功率" { size = 12, weight = medium, color = #94A3B8 }
                    use badge-warning("↓ 0.3%")
                }
                text "98.7%" { size = 32, weight = bold, color = colors.white, line-height = 36 }
                text "失败 612 次 · 大多限流" { size = 11, weight = normal, color = #64748B }
            }
        }

        // 趋势图双栏
        frame chart-row {
            width = fill height = hug layout = horizontal gap = 16

            // 请求量趋势
            frame chart-req {
                width = fill height = 320 padding = 20
                fill = colors.slate-800 radius = radius.lg stroke = [1, #334155]
                layout = vertical gap = 12

                frame head {
                    width = fill layout = horizontal justify = space-between align = center
                    frame col {
                        width = hug layout = vertical gap = 2
                        text "请求量趋势"   { size = 15, weight = semibold, color = colors.white }
                        text "每日调用总量" { size = 11, weight = normal, color = #64748B }
                    }
                    text "47k /日峰值" { size = 11, weight = medium, color = #94A3B8 }
                }

                // 伪面积图（7 根柱）
                frame chart-area {
                    width = fill height = fill layout = horizontal align = end justify = space-between gap = 14

                    frame b1 { width = fill layout = vertical align = center gap = 6
                        frame bar { width = fill height = 110 fill = #2563EB radius = [4, 4, 0, 0] }
                        text "04-12" { size = 10, weight = normal, color = #64748B }
                    }
                    frame b2 { width = fill layout = vertical align = center gap = 6
                        frame bar { width = fill height = 160 fill = #2563EB radius = [4, 4, 0, 0] }
                        text "04-13" { size = 10, weight = normal, color = #64748B }
                    }
                    frame b3 { width = fill layout = vertical align = center gap = 6
                        frame bar { width = fill height = 140 fill = #2563EB radius = [4, 4, 0, 0] }
                        text "04-14" { size = 10, weight = normal, color = #64748B }
                    }
                    frame b4 { width = fill layout = vertical align = center gap = 6
                        frame bar { width = fill height = 200 fill = #2563EB radius = [4, 4, 0, 0] }
                        text "04-15" { size = 10, weight = normal, color = #64748B }
                    }
                    frame b5 { width = fill layout = vertical align = center gap = 6
                        frame bar { width = fill height = 180 fill = #2563EB radius = [4, 4, 0, 0] }
                        text "04-16" { size = 10, weight = normal, color = #64748B }
                    }
                    frame b6 { width = fill layout = vertical align = center gap = 6
                        frame bar { width = fill height = 220 fill = #2563EB radius = [4, 4, 0, 0] }
                        text "04-17" { size = 10, weight = normal, color = #64748B }
                    }
                    frame b7 { width = fill layout = vertical align = center gap = 6
                        frame bar { width = fill height = 240 fill = #3B82F6 radius = [4, 4, 0, 0] }
                        text "04-18" { size = 10, weight = semibold, color = colors.white }
                    }
                }
            }

            // 收入趋势
            frame chart-rev {
                width = fill height = 320 padding = 20
                fill = colors.slate-800 radius = radius.lg stroke = [1, #334155]
                layout = vertical gap = 12

                frame head {
                    width = fill layout = horizontal justify = space-between align = center
                    frame col {
                        width = hug layout = vertical gap = 2
                        text "收入趋势"      { size = 15, weight = semibold, color = colors.white }
                        text "每日营收（元）" { size = 11, weight = normal, color = #64748B }
                    }
                    text "¥24,917 / 7天" { size = 11, weight = medium, color = #94A3B8 }
                }

                frame chart-area {
                    width = fill height = fill layout = horizontal align = end justify = space-between gap = 14

                    frame b1 { width = fill layout = vertical align = center gap = 6
                        frame bar { width = fill height = 130 fill = colors.success radius = [4, 4, 0, 0] }
                        text "04-12" { size = 10, weight = normal, color = #64748B }
                    }
                    frame b2 { width = fill layout = vertical align = center gap = 6
                        frame bar { width = fill height = 170 fill = colors.success radius = [4, 4, 0, 0] }
                        text "04-13" { size = 10, weight = normal, color = #64748B }
                    }
                    frame b3 { width = fill layout = vertical align = center gap = 6
                        frame bar { width = fill height = 150 fill = colors.success radius = [4, 4, 0, 0] }
                        text "04-14" { size = 10, weight = normal, color = #64748B }
                    }
                    frame b4 { width = fill layout = vertical align = center gap = 6
                        frame bar { width = fill height = 200 fill = colors.success radius = [4, 4, 0, 0] }
                        text "04-15" { size = 10, weight = normal, color = #64748B }
                    }
                    frame b5 { width = fill layout = vertical align = center gap = 6
                        frame bar { width = fill height = 180 fill = colors.success radius = [4, 4, 0, 0] }
                        text "04-16" { size = 10, weight = normal, color = #64748B }
                    }
                    frame b6 { width = fill layout = vertical align = center gap = 6
                        frame bar { width = fill height = 210 fill = colors.success radius = [4, 4, 0, 0] }
                        text "04-17" { size = 10, weight = normal, color = #64748B }
                    }
                    frame b7 { width = fill layout = vertical align = center gap = 6
                        frame bar { width = fill height = 240 fill = #10B981 radius = [4, 4, 0, 0] }
                        text "04-18" { size = 10, weight = semibold, color = colors.white }
                    }
                }
            }
        }

        // 渠道健康表
        frame health-table {
            width = fill height = hug
            fill = colors.slate-800 radius = radius.lg stroke = [1, #334155]
            layout = vertical

            frame head {
                width = fill padding = [16, 20] layout = horizontal justify = space-between align = center
                stroke = [1, #334155]
                frame col {
                    width = hug layout = vertical gap = 4
                    text "渠道健康" { size = 15, weight = semibold, color = colors.white }
                    text "上游渠道延迟 / 成功率 / 状态（实时）" { size = 11, weight = normal, color = #64748B }
                }
                frame actions {
                    width = hug layout = horizontal gap = 8
                    use button-ghost("📊 详情")
                    use button-ghost("🔄 测试全部")
                }
            }

            // 表头
            frame th {
                width = fill padding = [12, 20] layout = horizontal
                fill = #1E293B
                frame h1 { width = 180 text "渠道"      { size = 10, weight = semibold, color = #64748B, text-transform = uppercase, letter-spacing = 1.0 } }
                frame h2 { width = 140 text "PROVIDER"  { size = 10, weight = semibold, color = #64748B, text-transform = uppercase, letter-spacing = 1.0 } }
                frame h3 { width = 120 text "延迟"      { size = 10, weight = semibold, color = #64748B, text-transform = uppercase, letter-spacing = 1.0 } }
                frame h4 { width = 120 text "成功率"    { size = 10, weight = semibold, color = #64748B, text-transform = uppercase, letter-spacing = 1.0 } }
                frame h5 { width = 150 text "今日请求"  { size = 10, weight = semibold, color = #64748B, text-transform = uppercase, letter-spacing = 1.0 } }
                frame h6 { width = fill text "状态 / 操作" { size = 10, weight = semibold, color = #64748B, text-transform = uppercase, letter-spacing = 1.0 } }
            }

            // 行
            frame r1 {
                width = fill padding = [14, 20] stroke = [1, #334155]
                layout = horizontal align = center

                frame c1 { width = 180 text "prod-openai-us"   { size = 13, weight = medium, color = colors.white, family = "SF Mono" } }
                frame c2 { width = 140 use badge-gray("openai") }
                frame c3 { width = 120 text "184 ms" { size = 13, weight = normal, color = #10B981, family = "SF Mono" } }
                frame c4 { width = 120 text "99.8%"  { size = 13, weight = normal, color = colors.white } }
                frame c5 { width = 150 text "18,291" { size = 13, weight = normal, color = #CBD5E1 } }
                frame c6 { width = fill layout = horizontal gap = 8 align = center
                    use badge-success("● healthy")
                    use button-ghost("配置")
                }
            }

            frame r2 {
                width = fill padding = [14, 20] stroke = [1, #334155]
                layout = horizontal align = center

                frame c1 { width = 180 text "prod-anthropic" { size = 13, weight = medium, color = colors.white, family = "SF Mono" } }
                frame c2 { width = 140 use badge-gray("claude") }
                frame c3 { width = 120 text "312 ms" { size = 13, weight = normal, color = #F59E0B, family = "SF Mono" } }
                frame c4 { width = 120 text "98.2%"  { size = 13, weight = normal, color = colors.white } }
                frame c5 { width = 150 text "12,474" { size = 13, weight = normal, color = #CBD5E1 } }
                frame c6 { width = fill layout = horizontal gap = 8 align = center
                    use badge-warning("⚠ 高延迟")
                    use button-ghost("配置")
                }
            }

            frame r3 {
                width = fill padding = [14, 20] stroke = [1, #334155]
                layout = horizontal align = center

                frame c1 { width = 180 text "prod-deepseek"    { size = 13, weight = medium, color = colors.white, family = "SF Mono" } }
                frame c2 { width = 140 use badge-gray("deepseek") }
                frame c3 { width = 120 text "156 ms" { size = 13, weight = normal, color = #10B981, family = "SF Mono" } }
                frame c4 { width = 120 text "99.9%"  { size = 13, weight = normal, color = colors.white } }
                frame c5 { width = 150 text "8,921"  { size = 13, weight = normal, color = #CBD5E1 } }
                frame c6 { width = fill layout = horizontal gap = 8 align = center
                    use badge-success("● healthy")
                    use button-ghost("配置")
                }
            }

            frame r4 {
                width = fill padding = [14, 20]
                layout = horizontal align = center

                frame c1 { width = 180 text "backup-azure-eu" { size = 13, weight = medium, color = colors.white, family = "SF Mono" } }
                frame c2 { width = 140 use badge-gray("azure-openai") }
                frame c3 { width = 120 text "—"     { size = 13, weight = normal, color = #94A3B8, family = "SF Mono" } }
                frame c4 { width = 120 text "—"     { size = 13, weight = normal, color = #94A3B8 } }
                frame c5 { width = 150 text "0"     { size = 13, weight = normal, color = #94A3B8 } }
                frame c6 { width = fill layout = horizontal gap = 8 align = center
                    use badge-danger("● 已熔断")
                    use button-ghost("重置")
                }
            }
        }

        // 底部两栏：Top 用户 + 按模型
        frame bottom-row {
            width = fill layout = horizontal gap = 16

            // Top 用户
            frame top-users {
                width = fill padding = 20
                fill = colors.slate-800 radius = radius.lg stroke = [1, #334155]
                layout = vertical gap = 14

                frame head {
                    width = fill layout = horizontal justify = space-between align = center
                    frame col {
                        width = hug layout = vertical gap = 2
                        text "Top 10 用户" { size = 15, weight = semibold, color = colors.white }
                        text "按 7 天收入排名" { size = 11, weight = normal, color = #64748B }
                    }
                    use button-ghost("导出 CSV")
                }

                // 列表项
                frame u1 {
                    width = fill padding = [8, 0] layout = horizontal align = center gap = 12
                    frame rank { width = 28 height = 28 fill = colors.warning radius = radius.full layout = vertical justify = center align = center
                        text "1" { size = 12, weight = bold, color = colors.white } }
                    frame email-col { width = fill layout = vertical gap = 2
                        text "alice@example.com" { size = 13, weight = semibold, color = colors.white }
                        text "847 次调用 · ¥101 余额"  { size = 11, weight = normal, color = #64748B }
                    }
                    text "¥284.32" { size = 14, weight = bold, color = colors.success, family = "SF Mono" }
                }
                frame u2 {
                    width = fill padding = [8, 0] layout = horizontal align = center gap = 12
                    frame rank { width = 28 height = 28 fill = #94A3B8 radius = radius.full layout = vertical justify = center align = center
                        text "2" { size = 12, weight = bold, color = colors.white } }
                    frame email-col { width = fill layout = vertical gap = 2
                        text "bob@startup.io" { size = 13, weight = semibold, color = colors.white }
                        text "612 次调用 · ¥240 余额"  { size = 11, weight = normal, color = #64748B }
                    }
                    text "¥192.84" { size = 14, weight = bold, color = colors.success, family = "SF Mono" }
                }
                frame u3 {
                    width = fill padding = [8, 0] layout = horizontal align = center gap = 12
                    frame rank { width = 28 height = 28 fill = #A16207 radius = radius.full layout = vertical justify = center align = center
                        text "3" { size = 12, weight = bold, color = colors.white } }
                    frame email-col { width = fill layout = vertical gap = 2
                        text "charlie@team.dev" { size = 13, weight = semibold, color = colors.white }
                        text "389 次调用 · ¥68 余额"  { size = 11, weight = normal, color = #64748B }
                    }
                    text "¥128.11" { size = 14, weight = bold, color = colors.success, family = "SF Mono" }
                }
                frame u4 {
                    width = fill padding = [8, 0] layout = horizontal align = center gap = 12
                    frame rank { width = 28 height = 28 fill = colors.slate-600 radius = radius.full layout = vertical justify = center align = center
                        text "4" { size = 12, weight = bold, color = colors.white } }
                    frame email-col { width = fill layout = vertical gap = 2
                        text "diana@labs.com" { size = 13, weight = semibold, color = colors.white }
                        text "241 次调用 · ¥12 余额" { size = 11, weight = normal, color = #64748B }
                    }
                    text "¥87.42" { size = 14, weight = bold, color = #CBD5E1, family = "SF Mono" }
                }
                frame u5 {
                    width = fill padding = [8, 0] layout = horizontal align = center gap = 12
                    frame rank { width = 28 height = 28 fill = colors.slate-600 radius = radius.full layout = vertical justify = center align = center
                        text "5" { size = 12, weight = bold, color = colors.white } }
                    frame email-col { width = fill layout = vertical gap = 2
                        text "eric@demo.io" { size = 13, weight = semibold, color = colors.white }
                        text "158 次调用 · ¥3 余额"     { size = 11, weight = normal, color = #64748B }
                    }
                    text "¥64.18" { size = 14, weight = bold, color = #CBD5E1, family = "SF Mono" }
                }
            }

            // 按模型
            frame by-model {
                width = fill padding = 20
                fill = colors.slate-800 radius = radius.lg stroke = [1, #334155]
                layout = vertical gap = 14

                frame head {
                    width = fill layout = vertical gap = 2
                    text "Top 模型（按请求数）" { size = 15, weight = semibold, color = colors.white }
                    text "今日调用分布"        { size = 11, weight = normal, color = #64748B }
                }

                frame list {
                    width = fill layout = vertical gap = 12

                    frame row {
                        width = fill layout = horizontal align = center gap = 10
                        frame name { width = 160 text "gpt-4o-mini"        { size = 12, weight = medium, color = colors.white, family = "SF Mono" } }
                        frame bar  { width = 300 height = 20 fill = #3B82F6 radius = 4 }
                        text "18,291" { size = 11, weight = normal, color = #CBD5E1 }
                    }
                    frame r2 {
                        width = fill layout = horizontal align = center gap = 10
                        frame name { width = 160 text "claude-3-5-sonnet"  { size = 12, weight = medium, color = colors.white, family = "SF Mono" } }
                        frame bar  { width = 210 height = 20 fill = #10B981 radius = 4 }
                        text "12,474" { size = 11, weight = normal, color = #CBD5E1 }
                    }
                    frame r3 {
                        width = fill layout = horizontal align = center gap = 10
                        frame name { width = 160 text "gpt-4o"             { size = 12, weight = medium, color = colors.white, family = "SF Mono" } }
                        frame bar  { width = 150 height = 20 fill = #F59E0B radius = 4 }
                        text "8,921" { size = 11, weight = normal, color = #CBD5E1 }
                    }
                    frame r4 {
                        width = fill layout = horizontal align = center gap = 10
                        frame name { width = 160 text "deepseek-v3"        { size = 12, weight = medium, color = colors.white, family = "SF Mono" } }
                        frame bar  { width = 100 height = 20 fill = #8B5CF6 radius = 4 }
                        text "6,214" { size = 11, weight = normal, color = #CBD5E1 }
                    }
                    frame r5 {
                        width = fill layout = horizontal align = center gap = 10
                        frame name { width = 160 text "claude-3-5-haiku"   { size = 12, weight = medium, color = colors.white, family = "SF Mono" } }
                        frame bar  { width = 60 height = 20 fill = #EC4899 radius = 4 }
                        text "2,385" { size = 11, weight = normal, color = #CBD5E1 }
                    }
                }
            }
        }
    }
}