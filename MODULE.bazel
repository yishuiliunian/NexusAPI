"""NexusAPI — AI 大模型中转网关

Bazel 模块依赖。Go 后端 + Next.js 前端 + OCI 镜像。
"""

module(
    name = "nexusapi",
    version = "0.1.0",
)

# ==========================
# 基础 Bazel 工具
# ==========================
bazel_dep(name = "bazel_skylib", version = "1.8.1")
bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.8.1")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "aspect_bazel_lib", version = "2.19.2")

# buildifier（仅开发期）
bazel_dep(name = "buildifier_prebuilt", version = "7.3.1", dev_dependency = True)

# ==========================
# Go 后端
# ==========================
bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "gazelle", version = "0.47.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.5")

# 从 go.work 自动拉取所有 Go 模块依赖
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_work = "//:go.work")

# Go 依赖白名单（显式 use_repo 后才可在 BUILD 中引用）
# 只列当前代码实际 import 的依赖；新功能用到新依赖时同步扩充。
use_repo(
    go_deps,
    "com_github_alicebob_miniredis_v2",
    "com_github_gin_gonic_gin",
    "com_github_glebarez_sqlite",
    "com_github_golang_migrate_migrate_v4",
    "com_github_google_uuid",
    "com_github_gorilla_websocket",
    "com_github_hibiken_asynq",
    "com_github_redis_go_redis_v9",
    "com_github_spf13_cobra",
    "com_github_spf13_viper",
    "io_gorm_driver_postgres",
    "io_gorm_gorm",
    "in_gopkg_yaml_v3",
    "org_golang_x_crypto",
    "org_uber_go_zap",
)

# ==========================
# 前端 JS/TS
# ==========================
bazel_dep(name = "aspect_rules_js", version = "2.9.2")
bazel_dep(name = "aspect_rules_ts", version = "3.8.3")
bazel_dep(name = "aspect_rules_jest", version = "0.24.2")
bazel_dep(name = "rules_nodejs", version = "6.3.3")

# TypeScript 工具链
rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(
    ts_version = "5.7.3",
)
use_repo(rules_ts_ext, "npm_typescript")

# Node.js 工具链
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "20.9.0")
use_repo(node, "nodejs_toolchains")

register_toolchains("@nodejs_toolchains//:all")

# pnpm 依赖（从 pnpm-lock.yaml 生成）
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
    # eslint-config-next 必须 hoist 到根，否则 next lint 找不到
    public_hoist_packages = {
        "eslint-config-next": [""],
    },
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

# ==========================
# OCI 容器镜像
# ==========================
bazel_dep(name = "rules_oci", version = "2.0.0")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# Go 二进制使用 distroless/static（静态小镜像）
oci.pull(
    name = "distroless_static",
    image = "gcr.io/distroless/static-debian12",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
    tag = "latest",
)
use_repo(
    oci,
    "distroless_static",
    "distroless_static_linux_amd64",
    "distroless_static_linux_arm64_v8",
)

# Next.js 使用 node:20-slim
oci.pull(
    name = "node_slim",
    image = "docker.io/library/node",
    platforms = ["linux/amd64"],
    tag = "20-slim",
)
use_repo(
    oci,
    "node_slim",
    "node_slim_linux_amd64",
)
