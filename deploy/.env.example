# NexusAPI 部署环境变量示例。
# 复制为 .env 后按需修改。切勿提交 .env 到 git。

# ---------- 通用 ----------
# dev | staging | prod
NEXUSAPI_APP_ENV=prod

# ---------- Postgres ----------
POSTGRES_USER=nexusapi
POSTGRES_PASSWORD=change-me-to-random-strong-password
POSTGRES_DB=nexusapi

# ---------- Server ----------
NEXUSAPI_DATABASE_DSN=postgres://nexusapi:change-me-to-random-strong-password@postgres:5432/nexusapi?sslmode=disable
NEXUSAPI_LOG_LEVEL=info
NEXUSAPI_LOG_FORMAT=json

# 渠道凭证加密密钥（32 字节原文即可，内部 derive）
# 生产必须设置；开发可留空走 noop cipher
NEXUSAPI_SECURITY_CRYPTO_SECRET=change-me-to-32-bytes-of-entropy

# 计费
# 系统统一用 USD 计价；不做汇率换算
NEXUSAPI_BILLING_STRICT_PRICING=true
NEXUSAPI_BILLING_AUTO_SYNC_ON_STARTUP=true

# ---------- 镜像 tag ----------
NEXUSAPI_IMAGE_TAG=latest
