# NexusAPI 部署环境变量示例。
# 复制为 .env 后按需修改。切勿提交 .env 到 git。

# ---------- 通用 ----------
# dev | staging | prod
NEXUSAPI_APP_ENV=prod

# ---------- Postgres ----------
POSTGRES_USER=nexusapi
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=nexusapi
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Server ----------
NEXUSAPI_SERVER_HOST=0.0.0.0
NEXUSAPI_SERVER_PORT=8080
NEXUSAPI_DATABASE_DRIVER=postgres
NEXUSAPI_DATABASE_DSN=postgres://nexusapi:change-me-strong-password@postgres:5432/nexusapi?sslmode=disable
NEXUSAPI_REDIS_ADDR=redis:6379
NEXUSAPI_REDIS_PASSWORD=
NEXUSAPI_REDIS_DB=0
NEXUSAPI_LOG_LEVEL=info
NEXUSAPI_LOG_FORMAT=json

# ---------- 前端 ----------
WEB_USER_PORT=3000
WEB_ADMIN_PORT=3001
# 前端访问后端的地址（容器内网）
NEXUSAPI_BACKEND_URL=http://server:8080

# ---------- Caddy ----------
# 正式部署填你自己的域名；留空则仅暴露 80
NEXUSAPI_DOMAIN=
ADMIN_DOMAIN=

# 镜像 tag。CI 推送时使用 commit short sha。
NEXUSAPI_IMAGE_TAG=latest
